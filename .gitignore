# Environment variables - NEVER commit these!
.env
.env.local
.env.production
.env.*.local

# Database configuration with credentials - NEVER commit this!
config/database.local.php
config/database.local.php.*

# Email configuration with credentials - NEVER commit this!
config/email.local.php
config/email-password.php
config/email-localhost.php

# Database dumps - contain smtp_password and admin password hashes. NEVER commit!
Database/*.sql
Database/*.sql.gz
Database/*.json
Database/*.manifest.json

# Generated backups from scripts/backup_database.php — same contents, same rule.
# The script writes a deny-all .htaccess into backups/, but that only stops web
# access; without this rule a dump could still be committed to the repo.
backups/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
error.log

# Cache
cache/
*.cache
opcache/

# Temporary files
tmp/
temp/
*.tmp

# Composer (if using)
/vendor/
composer.lock

# Node modules (if using)
node_modules/
package-lock.json

# Claude Code — per-machine settings (absolute paths, local permission
# allowlist). The rest of .claude/ is the shared build system and IS tracked.
.claude/settings.local.json
