# Environment variables — NEVER commit the real .env file!
# Copy .env.example → .env on the server and fill in credentials.
.env
.env.local
.env.production
.env.*.local

# .env.example is safe to commit (contains no real credentials)
!.env.example

# config/database.local.php now contains NO credentials and IS committed.
# The real credentials live in .env (above).
# config/database.local.php   ← removed from ignore

# Database backups - generated locally / on server, never tracked
backups/
Database/
logs/backup.log
*.sql.gz

# Email configuration with credentials - NEVER commit this!
config/email.local.php
config/email-password.php
config/email-localhost.php

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local Copilot customization files
.github/copilot-instructions.md
.github/instructions/*.md

# OS files
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
error.log
error_log

# Cache
cache/
*.cache
opcache/

# Temporary files
tmp/
temp/
*.tmp

# Playwright MCP browser snapshots
.playwright-mcp/
*.yml

# Composer (if using)
/vendor/
composer.lock

# Node modules (if using)
node_modules/
package-lock.json
*.sql
