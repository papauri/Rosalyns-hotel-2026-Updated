# Rosalyns Hotel — Environment Variables Template
# Copy this file to .env and fill in the real values.
# The .env file is gitignored and must never be committed.
#
# chmod 600 .env   (recommended on Linux/cPanel)

DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306
# Generate a unique random string per hotel installation (e.g. openssl rand -hex 24)
APP_ENCRYPTION_SALT=

# cPanel Git Version Control (scripts/deploy_cpanel.php): account login.
CPANEL_HOST=
CPANEL_PORT=2083
CPANEL_USER=
CPANEL_PASS=
CPANEL_REPO_PATH=

# Emergency switch: set to 0 to stop forcing STRICT_TRANS_TABLES per connection (config/database.php).
# Leave unset/1 normally.
HOTEL_SQL_STRICT=1
