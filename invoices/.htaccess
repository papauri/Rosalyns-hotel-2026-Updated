# Generated guest documents (invoices, receipts, credit notes, quotations): never served directly.
# Staff open them through admin/document-download.php (permission-checked); PHP reads the files from disk.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
